  {
    "type": "rpc",
    "id": "rpc.luks.enableautounlock",
    "params": {
      "type": "object",
      "properties": {
        "devicefile": {
          "type": "string",
          "format": "devicefile",
          "required": true
        },
        "passphrase": {
          "type": "string",
          "required": false
        },
        "keyfile": {
          "type": "string",
          "required": false
        },
        "discards": {
          "type": "boolean",
          "required": false
        },
        "method": {
          "type": "string",
          "enum": ["keyfile", "tang", "tpm2", "tangtpm2"],
          "required": false
        },
        "tangurl": {
          "type": "string",
          "oneOf": [{
            "type": "string",
            "pattern": "^https?:\\/\\/[^\\s'\"]+$"
          },{
            "type": "string",
            "maxLength": 0
          }],
          "required": false
        },
        "tangthp": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "required": false
        }
      }
    }
  },
