msgstr "Lösenfraserna måste stämma överens."

msgid ""
"This command can have a negative security impact because it can make "
"filesystem-level operations visible on the physical device."
msgstr "Det här kommandot kan försämra säkerheten eftersom åtgärder på filsystemsnivå kan bli synliga på den fysiska enheten."

msgid "Unable to add auto-unlock key to encrypted device: %s"
msgstr "Det gick inte att lägga till nyckeln för automatisk upplåsning på den krypterade enheten: %s"

msgid "Unable to add the key to the encrypted device: %s"
msgstr "Det gick inte att lägga till nyckeln på den krypterade enheten: %s"

