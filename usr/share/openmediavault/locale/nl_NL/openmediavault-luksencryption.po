msgstr "Kan de sleutel niet wijzigen op het gecodeerde apparaat: %s"

msgid "Unable to create encrypted device: %s"
msgstr "Kan gecodeerd apparaat niet aanmaken: %s"

msgid "Unable to erase the key slot on the encrypted device: %s"
msgstr "Kan de sleutelpositie op het gecodeerde apparaat niet wissen: %s"

